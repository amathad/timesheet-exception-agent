DATABASE_URL=postgresql://postgres:<password>@localhost:5432/payroll
POSTGRES_PASSWORD=<choose-a-password>
# Claude API key from the Claude Console (billed separately from a Claude Pro subscription)
ANTHROPIC_API_KEY=<your-key>
# Optional: LangChain "provider:model" for the Outreach agent. Code default is
# anthropic:claude-opus-5-5; Haiku 5.5 is the cheapest (about $0.05 per simulated morning).
LLM_MODEL=anthropic:claude-haiku-5-5
# Optional: Claude effort per call: low | medium | high (default medium)
LLM_EFFORT=medium
# Optional: LangSmith tracing of graph runs (Module 6). Nothing is sent unless
# LANGSMITH_TRACING=true and a key is set. All project data is synthetic.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<your-langsmith-key>
LANGSMITH_PROJECT=timesheet-exception-agent
